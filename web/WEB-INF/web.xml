<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">

    <display-name>PetraRTW</display-name>

    <!-- Complaint Servlet -->
    <servlet>
        <servlet-name>ComplaintServlet</servlet-name>
        <servlet-class>petra.controller.ComplaintServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComplaintServlet</servlet-name>
        <url-pattern>/complaint</url-pattern>
    </servlet-mapping>

    <!-- Ticket Servlet -->
    <servlet>
        <servlet-name>TicketServlet</servlet-name>
        <servlet-class>petra.controller.TicketServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TicketServlet</servlet-name>
        <url-pattern>/tickets</url-pattern>
        <url-pattern>/tickets/detail</url-pattern>
    </servlet-mapping>

    <!-- Feedback Servlet -->
    <servlet>
        <servlet-name>FeedbackServlet</servlet-name>
        <servlet-class>petra.controller.FeedbackServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FeedbackServlet</servlet-name>
        <url-pattern>/feedback</url-pattern>
    </servlet-mapping>

    <!-- Auth Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>petra.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Home Servlet -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>petra.controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- Product Detail Servlet -->
    <servlet>
        <servlet-name>ProductDetailServlet</servlet-name>
        <servlet-class>petra.controller.ProductDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductDetailServlet</servlet-name>
        <url-pattern>/product</url-pattern>
    </servlet-mapping>

    <!-- Cart Servlet -->
    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>petra.controller.CartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/cart</url-pattern>
    </servlet-mapping>

    <!-- Checkout Servlet -->
    <servlet>
        <servlet-name>CheckoutServlet</servlet-name>
        <servlet-class>petra.controller.CheckoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckoutServlet</servlet-name>
        <url-pattern>/checkout</url-pattern>
    </servlet-mapping>

    <!-- Payment Gateway Servlet -->
    <servlet>
        <servlet-name>PaymentGatewayServlet</servlet-name>
        <servlet-class>petra.controller.PaymentGatewayServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentGatewayServlet</servlet-name>
        <url-pattern>/payment/gateway</url-pattern>
    </servlet-mapping>

    <!-- Payment Complete Servlet -->
    <servlet>
        <servlet-name>PaymentCompleteServlet</servlet-name>
        <servlet-class>petra.controller.PaymentCompleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentCompleteServlet</servlet-name>
        <url-pattern>/payment/complete</url-pattern>
    </servlet-mapping>

    <!-- Purchase Servlet -->
    <servlet>
        <servlet-name>PurchaseServlet</servlet-name>
        <servlet-class>petra.controller.PurchaseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PurchaseServlet</servlet-name>
        <url-pattern>/purchases</url-pattern>
        <url-pattern>/purchases/detail</url-pattern>
    </servlet-mapping>

    <!-- SalesAdmin Dashboard Servlet -->
    <servlet>
        <servlet-name>SalesAdminDashboardServlet</servlet-name>
        <servlet-class>petra.controller.SalesAdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalesAdminDashboardServlet</servlet-name>
        <url-pattern>/salesAdmin/home</url-pattern>
    </servlet-mapping>

    <!-- SalesAdmin Product Servlet -->
    <servlet>
        <servlet-name>SalesAdminProductServlet</servlet-name>
        <servlet-class>petra.controller.SalesAdminProductServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalesAdminProductServlet</servlet-name>
        <url-pattern>/salesAdmin/products</url-pattern>
    </servlet-mapping>

    <!-- SalesAdmin Feedback Servlet -->
    <servlet>
        <servlet-name>SalesAdminFeedbackServlet</servlet-name>
        <servlet-class>petra.controller.SalesAdminFeedbackServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalesAdminFeedbackServlet</servlet-name>
        <url-pattern>/salesAdmin/feedback</url-pattern>
    </servlet-mapping>

    <!-- SalesAdmin Customer Servlet -->
    <servlet>
        <servlet-name>SalesAdminCustomerServlet</servlet-name>
        <servlet-class>petra.controller.SalesAdminCustomerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalesAdminCustomerServlet</servlet-name>
        <url-pattern>/salesAdmin/customers</url-pattern>
    </servlet-mapping>

    <!-- SalesAdmin Purchase Servlet -->
    <servlet>
        <servlet-name>SalesAdminPurchaseServlet</servlet-name>
        <servlet-class>petra.controller.SalesAdminPurchaseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalesAdminPurchaseServlet</servlet-name>
        <url-pattern>/salesAdmin/purchases</url-pattern>
    </servlet-mapping>

    <!-- SalesAdmin Advertisement Servlet -->
    <servlet>
        <servlet-name>SalesAdminAdvertisementServlet</servlet-name>
        <servlet-class>petra.controller.SalesAdminAdvertisementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalesAdminAdvertisementServlet</servlet-name>
        <url-pattern>/salesAdmin/advertisements</url-pattern>
    </servlet-mapping>

    <!-- SalesAdmin Issue Servlet (list) -->
    <servlet>
        <servlet-name>SalesAdminIssueServlet</servlet-name>
        <servlet-class>petra.controller.SalesAdminIssueServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalesAdminIssueServlet</servlet-name>
        <url-pattern>/salesAdmin/issues</url-pattern>
    </servlet-mapping>

    <!-- SalesAdmin Issue Detail Servlet -->
    <servlet>
        <servlet-name>SalesAdminIssueDetailServlet</servlet-name>
        <servlet-class>petra.controller.SalesAdminIssueDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalesAdminIssueDetailServlet</servlet-name>
        <url-pattern>/salesAdmin/issues/detail</url-pattern>
    </servlet-mapping>

    <!-- Advertisement Servlet -->
    <servlet>
        <servlet-name>AdvertisementServlet</servlet-name>
        <servlet-class>petra.controller.AdvertisementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdvertisementServlet</servlet-name>
        <url-pattern>/advertisements</url-pattern>
    </servlet-mapping>

    <!-- Receipt Servlet -->
    <servlet>
        <servlet-name>ReceiptServlet</servlet-name>
        <servlet-class>petra.controller.ReceiptServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceiptServlet</servlet-name>
        <url-pattern>/receipt</url-pattern>
    </servlet-mapping>

    <!-- Auth Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>petra.util.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/home</url-pattern>
        <url-pattern>/product</url-pattern>
        <url-pattern>/cart</url-pattern>
        <url-pattern>/checkout</url-pattern>
        <url-pattern>/purchases</url-pattern>
        <url-pattern>/purchases/detail</url-pattern>
        <url-pattern>/payment/gateway</url-pattern>
        <url-pattern>/payment/complete</url-pattern>
        <url-pattern>/advertisements</url-pattern>
        <url-pattern>/tickets</url-pattern>
        <url-pattern>/tickets/detail</url-pattern>
        <url-pattern>/feedback</url-pattern>
        <url-pattern>/complaint</url-pattern>
        <url-pattern>/salesAdmin/*</url-pattern>
        <url-pattern>/salesAdmin/feedback</url-pattern>
    </filter-mapping>

    <!-- Welcome page -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session timeout 30 minutes -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
